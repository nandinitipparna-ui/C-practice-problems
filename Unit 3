5. Object as Class Member, Pointer to Class, this Pointer and Virtual Base Class
#include <iostream>
using namespace std;

// Object as class member
class Address {
public:
    string city;

    Address(string c) {
        city = c;
    }
};

class Student {
private:
    int rollNo;

public:
    Address address;   // Object as class member

    Student(int r, string city) : address(city) {
        rollNo = r;
    }

    void display() {
        cout << "Roll Number: " << rollNo << endl;
        cout << "City: " << address.city << endl;
    }

    void changeRollNo(int rollNo) {
        this->rollNo = rollNo;   // this pointer
    }
};

// Virtual base class
class A {
public:
    void showA() {
        cout << "Class A" << endl;
    }
};

class B : virtual public A {
};

class C : virtual public A {
};

class D : public B, public C {
};

int main() {

    // Object as class member
    Student s(101, "Hyderabad");

    cout << "Student details:" << endl;
    s.display();

    // this pointer
    s.changeRollNo(102);

    cout << "\nAfter changing roll number:" << endl;
    s.display();

    // Pointer to class
    Student *ptr = &s;

    cout << "\nUsing pointer to class:" << endl;
    ptr->display();

    // Virtual base class
    D obj;

    cout << "\nUsing virtual base class:" << endl;
    obj.showA();

    return 0;
}
